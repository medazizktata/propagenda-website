NEXT_PUBLIC_SITE_URL=https://thepropagenda.com
NEXT_PUBLIC_GA_ID=

# Public studio inbox (footer, mailto, legal, JSON-LD). Swap to info@ when ready.
NEXT_PUBLIC_CONTACT_EMAIL=propagendamarketing@gmail.com

# --- Feature flags (Vercel → Project → Environment Variables) ---
# true/false, 1/0, on/off all work.

# Soft launch: lock unfinished pages behind coming-soon popup. Default on.
NEXT_PUBLIC_FF_SOFT_LAUNCH=true

# Unlock individual sections while soft launch stays on (default locked).
# Locked sections drop from nav/CTAs and hard-redirect to home.
NEXT_PUBLIC_FF_PAGE_ABOUT=true
NEXT_PUBLIC_FF_PAGE_SERVICES=true
NEXT_PUBLIC_FF_PAGE_WORK=false
NEXT_PUBLIC_FF_PAGE_CONTACT=true
NEXT_PUBLIC_FF_PAGE_LEGAL=true

# Orange quote splash on every full page load. Default on.
NEXT_PUBLIC_FF_INIT_LOADER=true

# Page transition: false = simple Cuberto wipe (default). true = ornate orange curtain.
NEXT_PUBLIC_FF_COMPLEX_CURTAIN=false

# Contact form → Resend (domain thepropagenda.com verified).
# Prod: leave CONTACT_TO_EMAIL empty → NEXT_PUBLIC_CONTACT_EMAIL (live inbox).
# Dev: set CONTACT_TO_EMAIL to a throwaway while testing, or the live inbox once From is on-domain.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="Propagenda <noreply@thepropagenda.com>"
RESEND_API_KEY=

# Scheduling link for all "Book a call" CTAs (Calendly event or any provider)
NEXT_PUBLIC_BOOKING_URL=https://calendly.com/your-handle/your-event

# Outside production, real email sends require explicit opt-in (safety: a local
# RESEND_API_KEY must not make every dev form-submit send a real email).
CONTACT_SEND_ENABLED=

# Cloudflare Turnstile (contact form). Site key is public; secret is Worker-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Comma-separated hostnames accepted by siteverify (prod defaults if empty).
TURNSTILE_HOSTNAMES=thepropagenda.com,www.thepropagenda.com

# --- CMS (Supabase) ---
# Services, case studies, and video work are read from the database when Supabase is configured.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret for POST /api/revalidate (publish webhook).
REVALIDATE_SECRET=
# Comma-separated emails allowed into /admin (required in production).
CMS_ADMIN_EMAILS=admin@thepropagenda.com,contact@thepropagenda.com,propagendamarketing@gmail.com
# Default CMS login for local Supabase seed.sql (override before pnpm seed:sql).
CMS_DEFAULT_ADMIN_EMAIL=admin@thepropagenda.com
CMS_DEFAULT_ADMIN_PASSWORD=
