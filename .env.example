NEXT_PUBLIC_SITE_URL=https://thepropagenda.com
NEXT_PUBLIC_GA_ID=

# Public studio inbox (footer, mailto, legal, JSON-LD). Swap to info@ when ready.
NEXT_PUBLIC_CONTACT_EMAIL=propagendamarketing@gmail.com

# --- Feature flags (Vercel → Project → Environment Variables) ---
# true/false, 1/0, on/off all work.

# Soft launch: lock unfinished pages behind coming-soon popup. Default on.
NEXT_PUBLIC_FF_SOFT_LAUNCH=true

# Unlock individual sections while soft launch stays on (default locked).
# Locked sections drop from nav/CTAs and hard-redirect to home.
NEXT_PUBLIC_FF_PAGE_ABOUT=true
NEXT_PUBLIC_FF_PAGE_SERVICES=true
NEXT_PUBLIC_FF_PAGE_WORK=false
NEXT_PUBLIC_FF_PAGE_CONTACT=true
NEXT_PUBLIC_FF_PAGE_LEGAL=true

# Orange quote splash on every full page load. Default on.
NEXT_PUBLIC_FF_INIT_LOADER=true

# Contact form → Resend. To: CONTACT_TO_EMAIL (dev throwaway) else NEXT_PUBLIC_CONTACT_EMAIL.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="Propagenda <onboarding@resend.dev>"
RESEND_API_KEY=

# Scheduling link for all "Book a call" CTAs (Calendly event or any provider)
NEXT_PUBLIC_BOOKING_URL=https://calendly.com/your-handle/your-event
