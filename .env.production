# Public build flags for production builds (Cloudflare builds from GitHub read this file).
# NEXT_PUBLIC_* values are inlined into the public JS at build time, so nothing here is secret.
# Without it the Cloudflare build fell back to defaults and locked /work (2026-09-24).
# Secrets and personal values stay out of the repo: set them in the Cloudflare dashboard.
NEXT_PUBLIC_FF_SOFT_LAUNCH=true
NEXT_PUBLIC_FF_PAGE_ABOUT=true
NEXT_PUBLIC_FF_PAGE_SERVICES=true
NEXT_PUBLIC_FF_PAGE_WORK=true
NEXT_PUBLIC_FF_PAGE_CONTACT=true
NEXT_PUBLIC_FF_PAGE_LEGAL=true
NEXT_PUBLIC_FF_INIT_LOADER=true
NEXT_PUBLIC_FF_COMPLEX_CURTAIN=false
NEXT_PUBLIC_HERO_VARIANT=cubes
