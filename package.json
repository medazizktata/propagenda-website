{
  "name": "propagenda",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "next dev --turbopack --port 4000",
    "build": "opennextjs-cloudflare build",
    "build:next": "next build",
    "start": "next start --port 4000",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "check:static-content": "tsx tools/perf/check-static-content.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm perf --skip-bundle",
    "check:build": "NEXT_DIST_DIR=.next-prod pnpm build:next",
    "perf": "tsx tools/perf/run.ts",
    "perf:assets": "tsx tools/perf/check-public-assets.ts",
    "perf:videos": "tsx tools/perf/check-videos.ts",
    "perf:bundle": "tsx tools/perf/check-bundle.ts",
    "perf:images": "tsx tools/perf/optimize-images.ts",
    "perf:lighthouse": "tsx tools/perf/lighthouse.ts",
    "perf:lhci": "pnpm check:build && lhci autorun",
    "perf:all": "pnpm perf && pnpm check:build && pnpm perf:bundle",
    "analyze": "next experimental-analyze --port 4001",
    "analyze:webpack": "ANALYZE=true NEXT_DIST_DIR=.next-prod pnpm build:next",
    "test:perf": "playwright test e2e/perf.spec.ts",
    "test:e2e": "playwright test",
    "preview": "rm -rf .open-next && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "rm -rf .open-next && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:typegen": "supabase gen types typescript --local > types/database.types.ts",
    "seed:sql": "tsx scripts/generate-seed-sql.ts",
    "seed:cms": "tsx scripts/seed-cms.ts",
    "seed:admin": "tsx scripts/seed-admin-user.ts",
    "db:reset": "pnpm seed:sql && pnpm supabase:reset"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.10",
    "framer-motion": "^12.42.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.31.0",
    "msw": "^2.15.0",
    "next": "^16.2.10",
    "photoswipe": "^5.4.4",
    "postcss": "^8.5.16",
    "prettier": "^3.9.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-rough-notation": "^1.0.8",
    "resend": "^6.20.0",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^16.2.10",
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "^1.62.1",
    "@types/photoswipe": "^4.1.6",
    "@types/three": "^0.185.1",
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^12.8.2",
    "sharp": "^0.34.5",
    "tsx": "^4.23.13",
    "wrangler": "^4.124.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}