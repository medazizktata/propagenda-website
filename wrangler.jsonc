{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "propagenda-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "propagenda-website"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  },
  // Non-secret contact delivery. RESEND_API_KEY is a Worker secret (not committed).
  "vars": {
    "CONTACT_FROM_EMAIL": "Propagenda <noreply@thepropagenda.com>",
    "CONTACT_TO_EMAIL": "contact@thepropagenda.com",
    "NEXT_PUBLIC_CONTACT_EMAIL": "contact@thepropagenda.com",
    "NEXT_PUBLIC_FF_COMPLEX_CURTAIN": "false",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAEXndoVcXl1or5zJ",
    "TURNSTILE_HOSTNAMES": "thepropagenda.com,www.thepropagenda.com"
  }
}
